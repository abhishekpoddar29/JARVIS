# Jarvis 2.0 local development environment.
# Copy the values you need into backend/.env or your Docker Compose environment.

APP_NAME="Jarvis 2.0"
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_STT_TIMEOUT_SECONDS=60
VOICE_MAX_AUDIO_BYTES=6000000

SERPER_API_KEY=
PERPLEXITY_API_KEY=
OPENWEATHER_API_KEY=
NEWSDATA_API_KEY=
E2B_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=IN
YOUTUBE_RELEVANCE_LANGUAGE=en
YOUTUBE_SEARCH_LIMIT=8
YOUTUBE_TIMEOUT_SECONDS=12
YOUTUBE_CACHE_TTL_SECONDS=600

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=jarvis

REDIS_URL=redis://redis:6379/0
TRACKING_REDIS_URL=redis://redis:6379/1
SESSION_TTL_SECONDS=86400

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
TOKEN_ENCRYPTION_KEY=
GOOGLE_ACCOUNT_COOKIE=

TRACKING_PUBLIC_BASE_URL=
TRACKING_ADMIN_TOKEN=
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_TIMEOUT_SECONDS=10
SMS_GATEWAY_SIM_NUMBER=

# Security / hardening controls
JARVIS_APP_TOKEN=
JARVIS_AUTH_REQUIRED=false
ENABLE_SELF_MODIFY=false
ENABLE_MCP_FILESYSTEM=true
ENABLE_CODE_EXECUTION=true
ENABLE_WEB_SCRAPER=true
UPLOAD_MAX_BYTES=25000000
UPLOAD_ALLOWED_EXTENSIONS=.csv,.json,.txt,.xlsx,.png,.jpg,.jpeg,.webp
SCRAPER_BLOCK_PRIVATE_NETWORKS=true
